# Optional: your preferred public origin, e.g. https://your-project.vercel.app.
# On Vercel, leaving this blank uses VERCEL_PROJECT_PRODUCTION_URL automatically.
# Set this to your custom domain if you want that domain in search results.
NEXT_PUBLIC_SITE_URL=

# Google Search Console > URL-prefix property > HTML tag > content value.
# Set this in Vercel's Production environment, then redeploy before verifying.
GOOGLE_SITE_VERIFICATION=
